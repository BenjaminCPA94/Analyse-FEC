{
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "src/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "30 2 * * *"
    }
  ]
}
