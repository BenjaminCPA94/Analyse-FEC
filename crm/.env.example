# Copier en « .env » puis compléter. Ce fichier ne doit jamais être commité.
PORT=8080
# true derrière HTTPS (obligatoire en production)
COOKIE_SECURE=false

# Pennylane — facturation du cabinet (société RB Partners dans Pennylane)
# Paramètres > Connectivité > Développeurs > Générer un jeton API, lecture seule :
# scopes customer_invoices:readonly et customers:readonly
PENNYLANE_CABINET_TOKEN=

# Pennylane — API cabinet (accès aux balances des dossiers clients), optionnel
# si tu préfères un jeton par dossier (saisi dans le CRM). Scope trial_balance:readonly.
PENNYLANE_FIRM_TOKEN=

# Adresses des API (ne changer que si Pennylane les modifie)
# PENNYLANE_API_BASE=https://app.pennylane.com/api/external/v2
# PENNYLANE_FIRM_API_BASE=https://app.pennylane.com/api/external/firm/v1
