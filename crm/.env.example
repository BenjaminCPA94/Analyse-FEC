# Copier en « .env » puis compléter. Ce fichier ne doit jamais être commité.
# Sur Vercel, ces mêmes variables se saisissent dans Settings › Environment Variables.

# Premier compte administrateur, créé à la première connexion si aucun compte n'existe.
# Supprime ADMIN_PASSWORD une fois connecté (il ne sert plus).
ADMIN_USERNAME=
ADMIN_PASSWORD=
PORT=8080
# true derrière HTTPS (obligatoire en production)
COOKIE_SECURE=false

# Pennylane — facturation du cabinet (société RB Partners dans Pennylane)
# Paramètres > Connectivité > Développeurs > Générer un jeton API, lecture seule :
# scopes customer_invoices:readonly et customers:readonly
PENNYLANE_CABINET_TOKEN=

# Pennylane — API cabinet (liste des dossiers, pour les liens directs), optionnel
PENNYLANE_FIRM_TOKEN=

# Adresses des API (ne changer que si Pennylane les modifie)
# PENNYLANE_API_BASE=https://app.pennylane.com/api/external/v2
# PENNYLANE_FIRM_API_BASE=https://app.pennylane.com/api/external/firm/v1

# Base de données Upstash Redis (renseignées automatiquement par Vercel quand on connecte
# « Upstash for Redis » au projet). Sans elles, le serveur local stocke tout dans data/.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
